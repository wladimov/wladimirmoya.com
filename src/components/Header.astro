---
import { NAME } from '../consts';
import HeaderSocial from './HeaderSocial.astro';
---

<header>
  <section>
    <h2><a href='/'>{NAME}</a></h2>
    <HeaderSocial />
  </section>
</header>
<style>
  header {
    margin: 0em 0 2em;
  }
  section {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  h2 a {
    color: black;
    text-decoration: none;
  }
  h2 {
    padding: 0;
    margin: 0;
  }
  h2 a:hover {
    text-decoration: underline;
    color: #1b99ff;
  }
</style>
